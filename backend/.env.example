# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Database ---
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://credchain:credchain@localhost:5432/credchain

# --- Auth / JWT (used starting Phase 3) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Sharing (Phase 6) ---
FRONTEND_BASE_URL=http://localhost:5173

# --- AI (Phase 7) ---
# Leave AI_ENABLED=false (or AI_API_KEY empty) to run in fallback/demo mode —
# every AI endpoint still works, using a clearly-labeled deterministic
# analyzer instead of a real LLM call. See app/services/ai/ai_service.py.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5

# --- Document storage ---
STORAGE_PATH=./storage
MAX_DOCUMENT_SIZE_BYTES=10485760

# --- Document storage (Supabase Storage) ---
# Leave both empty to keep using local filesystem storage at STORAGE_PATH above (every
# existing test does this). Local disk on Render does NOT survive a redeploy — set both of
# these once the two PRIVATE buckets below have been created in Supabase to switch NEW
# uploads over to durable storage. SUPABASE_SERVICE_ROLE_KEY must never be committed, logged,
# or sent to the frontend — same handling as KEY_ENCRYPTION_SECRET/BLOCKCHAIN_PRIVATE_KEY above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CREDENTIAL_BUCKET=credential-documents
SUPABASE_STUDENT_DOCUMENT_BUCKET=student-documents

# --- Institution signing keys ---
# Legacy per-institution PEM directory — kept only as a compatibility fallback for
# institutions not yet migrated to encrypted database storage (see KEY_ENCRYPTION_SECRET
# below and app/services/signing_service.py). New institutions no longer write here at all.
# Never commit real key material.
KEYS_PATH=./keys

# Master secret for encrypting institution private keys before they're stored in
# Postgres (institutions.encrypted_private_key). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Keep this ONLY as a Render env var in production — never in the database, never in
# source control, and never the same value as JWT_SECRET_KEY. Losing this secret means
# every encrypted private key becomes permanently unrecoverable, so store it securely
# (e.g. a password manager) outside of Render too.
KEY_ENCRYPTION_SECRET=changeme-generate-a-real-random-secret

# --- Blockchain credential-hash anchoring (Phase 9A/9B) ---
# Leave BLOCKCHAIN_ENABLED=false to run with no RPC/wallet configured — the
# anchor endpoint fails cleanly with blockchain_status=FAILED instead of
# attempting a network call. See blockchain/README.md for how to get a
# Polygon Amoy RPC URL and testnet funds, and how to deploy the contract.
#
# BLOCKCHAIN_PRIVATE_KEY is a BACKEND SERVICE wallet key — NOT the
# institution's Ed25519 signing key, NOT a student's key, NOT a company's
# key. It only ever needs a small amount of testnet gas, never real funds.
# Never commit a real value here. In production this should come from a
# KMS/HSM or a managed wallet service, not a plaintext .env file.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_NETWORK_NAME=polygon-amoy
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
